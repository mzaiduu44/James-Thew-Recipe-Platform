# Guest/reader credentials used by getGuestToken() to authenticate public GET reads.
# These are needed only because public endpoints currently require [Authorize].
# The real fix is backend-side: public GETs should be [AllowAnonymous].
VITE_GUEST_EMAIL=
VITE_GUEST_PASSWORD=

# Optional: override the API backend URL (defaults to http://jamesthewrecipe.runasp.net)
# VITE_API_BASE_URL=
